FROM node:20-slim AS builder

WORKDIR /app
ARG BACKEND_URL=http://backend:4000
ARG NEXT_PUBLIC_IP2P_NETWORK=testnet
ARG NEXT_PUBLIC_PLATFORM_XPUB_BTC
ARG NEXT_PUBLIC_PLATFORM_XPUB_LTC
ARG NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC
ARG NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_IP2P_NETWORK=$NEXT_PUBLIC_IP2P_NETWORK
ENV NEXT_PUBLIC_PLATFORM_XPUB_BTC=$NEXT_PUBLIC_PLATFORM_XPUB_BTC NEXT_PUBLIC_PLATFORM_XPUB_LTC=$NEXT_PUBLIC_PLATFORM_XPUB_LTC
ENV NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC=$NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC=$NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC
ENV NEXT_TELEMETRY_DISABLED=1

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source code and config
COPY tsconfig.json ./
COPY next.config.js ./
COPY src ./src

# Build Next.js application
RUN npm run build

# Production image
FROM node:20-slim

WORKDIR /app
ARG BACKEND_URL=http://backend:4000
ARG NEXT_PUBLIC_IP2P_NETWORK=testnet
ARG NEXT_PUBLIC_PLATFORM_XPUB_BTC
ARG NEXT_PUBLIC_PLATFORM_XPUB_LTC
ARG NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC
ARG NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_IP2P_NETWORK=$NEXT_PUBLIC_IP2P_NETWORK
ENV NEXT_PUBLIC_PLATFORM_XPUB_BTC=$NEXT_PUBLIC_PLATFORM_XPUB_BTC NEXT_PUBLIC_PLATFORM_XPUB_LTC=$NEXT_PUBLIC_PLATFORM_XPUB_LTC
ENV NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC=$NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_BTC NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC=$NEXT_PUBLIC_PLATFORM_FEE_ADDRESS_LTC
ENV NEXT_TELEMETRY_DISABLED=1

# Copy package files and install production dependencies
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy built application and config from builder
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.js ./next.config.js

# Run as non-root user
USER node

EXPOSE 3000

CMD ["npm", "start"]
