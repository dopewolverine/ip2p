NODE_ENV=production
PORT=4000

# mainnet | testnet. P2 §11: no mainnet trading until every asset has
# completed a full lifecycle on testnet.
IP2P_NETWORK=testnet
# Kill switches. Trading stays closed until the testnet matrix passes.
REGISTRATION_OPEN=true
TRADING_OPEN=false
# Never true in production (engine-test endpoints from P2 §1).
ALLOW_ENGINE_TEST_ENDPOINTS=false

MIGRATE_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/ip2p
DATABASE_URL=postgres://ip2p_app:CHANGE_ME@localhost:5433/ip2p

# 32 random bytes, hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=CHANGE_ME
APP_ENC_KEY=CHANGE_ME

FRONTEND_URL=https://ip2p.to

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@ip2p.to

NOWNODES_API_KEY=CHANGE_ME
# NOWNODES_BTC_BLOCKBOOK_URL=https://btcbook.nownodes.io   (testnet: the provider's testnet Blockbook)
# NOWNODES_LTC_BLOCKBOOK_URL=https://ltcbook.nownodes.io
# NOWNODES_BTC_WS_URL=wss://btcbook.nownodes.io/wss/<api-key>   (verify format with NOWNodes)
# NOWNODES_LTC_WS_URL=wss://ltcbook.nownodes.io/wss/<api-key>
# NOWNODES_ETH_BLOCKBOOK_URL / NOWNODES_ETH_RPC_URL / NOWNODES_TRX_RPC_URL
# TRONGRID_API_KEY / TRONGRID_API_URL / BLOCKSTREAM_API_URL
# ESCROW_SWEEP_MS=60000

# Platform fee addresses (server copy — the frontend build pins its own).
PLATFORM_FEE_ADDRESS_BTC=CHANGE_ME
PLATFORM_FEE_ADDRESS_LTC=CHANGE_ME

DISCOVERY_OUTPUT_ROOT=/var/www/pages
SITE_URL=https://ip2p.to

ATTACHMENTS_STORAGE_DIR=/var/data/ip2p/attachments
ATTACHMENT_MAX_BYTES=10485760

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=   (random string; pass as secret_token to setWebhook)
